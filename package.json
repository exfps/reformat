{
  "name": "reformat",
  "version": "1.1.0",
  "description": "A friendly, local-first file workbench for macOS \u2014 images, PDFs, GIFs, and archives",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:dev": "npm run helper && tauri dev",
    "app:build": "npm run helper && tauri build",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run build && npm run test",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "fmt:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "icons": "node scripts/generate-icons.mjs",
    "helper": "bash scripts/build-video-helper.sh"
  },
  "keywords": [
    "archives",
    "conversion",
    "desktop",
    "image-conversion",
    "local-first",
    "macos",
    "pdf",
    "pdf-export",
    "privacy",
    "tauri",
    "video-to-gif"
  ],
  "author": "Reformat contributors",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "lucide-react": "^1.79.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "private": true,
  "engines": {
    "node": ">=20.19"
  }
}
